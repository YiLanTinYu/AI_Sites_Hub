---
import PlanCard from "../../components/PlanCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { planRows } from "../../lib/data";
import {
  estimatedMonthlyCny,
  productProfiles,
  productScenarios,
  type ProductScenarioId,
} from "../../lib/product-recommendations";

const providerOrder = new Map(
  [
    "openai",
    "anthropic",
    "google",
    "perplexity",
    "github",
    "cursor",
    "midjourney",
    "runway",
    "suno",
    "elevenlabs",
    "deepseek",
    "moonshot",
    "zhipu",
    "baidu-comate",
  ].map((id, index) => [id, index]),
);
const rows = [...planRows].sort(
  (a, b) =>
    (providerOrder.get(a.providerId) ?? Number.POSITIVE_INFINITY) -
      (providerOrder.get(b.providerId) ?? Number.POSITIVE_INFINITY) ||
    (a.monthlyPrice ?? Number.POSITIVE_INFINITY) -
      (b.monthlyPrice ?? Number.POSITIVE_INFINITY),
);
const providerCount = new Set(rows.map((row) => row.providerId)).size;
const globalRows = rows.filter((row) => row.provider.region === "global");
const chinaRows = rows.filter((row) => row.provider.region === "china");
const profileByProvider = new Map(productProfiles.map((profile) => [profile.providerId, profile]));
const scenarioEntries = Object.entries(productScenarios) as Array<
  [ProductScenarioId, (typeof productScenarios)[ProductScenarioId]]
>;
---

<BaseLayout
  title="AI 订阅套餐对比 | 惠选AI"
  description="比较 ChatGPT、Claude、Gemini 等主流 AI 产品的免费方案、个人月费、年付折算、使用额度和适用人群。"
>
  <section class="page-head shell">
    <p>AI SUBSCRIPTION PLANS</p>
    <h1>AI 订阅套餐</h1>
    <div class="summary">
      <span>{rows.length} 个个人套餐</span>
      <span>{providerCount} 家主流产品</span>
      <span>{globalRows.length} 个国外套餐 · {chinaRows.length} 个国内套餐</span>
    </div>
    <div class="plain-note">
      <strong>额度怎么看？</strong>
      <span>多数个人套餐不会承诺固定 Token 数，而是按消息、功能和系统负载动态调整。这里按厂商公开方式展示，不虚构固定额度。</span>
    </div>
  </section>

  <nav class="region-filter shell" aria-label="按地区筛选套餐">
    <a href="/plans/" data-region-filter="all" aria-current="page">
      全部
      <span>{rows.length}</span>
    </a>
    <a href="/plans/?region=china" data-region-filter="china">
      国内套餐
      <span>{chinaRows.length}</span>
    </a>
    <a href="/plans/?region=global" data-region-filter="global">
      国外套餐
      <span>{globalRows.length}</span>
    </a>
  </nav>

  <section class="plan-controls shell" aria-label="筛选和排序订阅套餐">
    <div>
      <span>主要用途</span>
      <div class="control-group" data-plan-control="scenario">
        <button type="button" data-scenario="all" aria-pressed="true">全部场景</button>
        {scenarioEntries.map(([id, scenario]) => (
          <button type="button" data-scenario={id}>{scenario.name}</button>
        ))}
      </div>
    </div>
    <div>
      <span>预算范围</span>
      <div class="control-group" data-plan-control="budget">
        <button type="button" data-budget="all" aria-pressed="true">不限预算</button>
        <button type="button" data-budget="0">免费</button>
        <button type="button" data-budget="70">约 ¥70 内</button>
        <button type="button" data-budget="150">约 ¥150 内</button>
      </div>
    </div>
    <label class="free-toggle">
      <input type="checkbox" data-free-only />
      <span>只看免费套餐</span>
    </label>
    <label class="sort-control">
      <span>排序</span>
      <select data-sort-plans>
        <option value="recommended">综合推荐</option>
        <option value="price-asc">价格从低到高</option>
        <option value="price-desc">价格从高到低</option>
        <option value="verified-desc">最近核实优先</option>
      </select>
    </label>
    <p class="filter-status" data-filter-status aria-live="polite"></p>
  </section>

  <section class="shell plan-section" data-plan-sections>
    <section class="region-section" data-plan-region="global" aria-labelledby="global-plans">
      <div class="region-heading">
        <div>
          <p>GLOBAL PRODUCTS</p>
          <h2 id="global-plans">国外主流 AI 产品</h2>
        </div>
        <span>{globalRows.length} 个套餐</span>
      </div>
      <div class="plan-grid">
        {globalRows.map((plan) => {
          const profile = profileByProvider.get(plan.providerId);
          return (
            <div
              class="plan-item"
              data-plan-card
              data-region="global"
              data-provider={plan.providerId}
              data-scenarios={profile?.uses.join(",") ?? ""}
              data-price-cny={estimatedMonthlyCny(plan.currency, plan.monthlyPrice, plan.annualMonthlyEquivalent)}
              data-free={String(plan.monthlyPrice === 0 || plan.billingOptions.includes("free"))}
              data-verified={plan.verifiedAt}
              data-quality={profile?.quality ?? 5}
              data-ease={profile?.ease ?? 5}
            >
              <PlanCard plan={plan} />
            </div>
          );
        })}
      </div>
    </section>

    <section class="region-section" data-plan-region="china" aria-labelledby="china-plans">
      <div class="region-heading">
        <div>
          <p>CHINA PRODUCTS</p>
          <h2 id="china-plans">国内主流 AI 产品</h2>
        </div>
        <span>{chinaRows.length} 个套餐</span>
      </div>
      <div class="plan-grid">
        {chinaRows.map((plan) => {
          const profile = profileByProvider.get(plan.providerId);
          return (
            <div
              class="plan-item"
              data-plan-card
              data-region="china"
              data-provider={plan.providerId}
              data-scenarios={profile?.uses.join(",") ?? ""}
              data-price-cny={estimatedMonthlyCny(plan.currency, plan.monthlyPrice, plan.annualMonthlyEquivalent)}
              data-free={String(plan.monthlyPrice === 0 || plan.billingOptions.includes("free"))}
              data-verified={plan.verifiedAt}
              data-quality={profile?.quality ?? 5}
              data-ease={profile?.ease ?? 5}
            >
              <PlanCard plan={plan} />
            </div>
          );
        })}
      </div>
    </section>
    <div class="empty-state" data-plan-empty hidden>当前没有符合条件的套餐，可以放宽预算或切换用途再看。</div>
    <p class="method-note">
      页面价格以美元区官网公开信息为主，不同地区的税费、币种、试用活动及功能可能不同。个人订阅通常不包含开发接口（API）额度，程序调用成本请查看
      <a href="/models/">开发者 API 价格</a>。
    </p>
  </section>

  <script>
    const filters = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-region-filter]"));
    const planSections = Array.from(document.querySelectorAll<HTMLElement>("[data-plan-region]"));
    const planCards = Array.from(document.querySelectorAll<HTMLElement>("[data-plan-card]"));
    const scenarioButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-scenario]"));
    const budgetButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-budget]"));
    const freeOnly = document.querySelector<HTMLInputElement>("[data-free-only]");
    const sortSelect = document.querySelector<HTMLSelectElement>("[data-sort-plans]");
    const filterStatus = document.querySelector<HTMLElement>("[data-filter-status]");
    const emptyState = document.querySelector<HTMLElement>("[data-plan-empty]");
    const validRegions = new Set(["all", "china", "global"]);
    const validBudgets = new Set(["all", "0", "70", "150"]);
    const validScenarios = new Set(["all", "chat", "research", "coding", "image", "video", "audio", "office"]);
    const validSorts = new Set(["recommended", "price-asc", "price-desc", "verified-desc"]);

    let activeRegion = regionFromUrl();
    let activeScenario = new URL(window.location.href).searchParams.get("scenario") ?? "all";
    let activeBudget = new URL(window.location.href).searchParams.get("budget") ?? "all";
    let activeSort = new URL(window.location.href).searchParams.get("sort") ?? "recommended";

    function normalizeState() {
      activeRegion = validRegions.has(activeRegion) ? activeRegion : "all";
      activeScenario = validScenarios.has(activeScenario) ? activeScenario : "all";
      activeBudget = validBudgets.has(activeBudget) ? activeBudget : "all";
      activeSort = validSorts.has(activeSort) ? activeSort : "recommended";
    }

    function priceOf(card: HTMLElement) {
      return Number(card.dataset.priceCny ?? "99999");
    }

    function scoreOf(card: HTMLElement) {
      const quality = Number(card.dataset.quality ?? "5");
      const ease = Number(card.dataset.ease ?? "5");
      const price = priceOf(card);
      return quality * 10 + ease * 3 - price * 0.018;
    }

    function cardVisible(card: HTMLElement) {
      if (activeRegion !== "all" && card.dataset.region !== activeRegion) return false;
      if (activeScenario !== "all") {
        const scenarios = card.dataset.scenarios?.split(",") ?? [];
        if (!scenarios.includes(activeScenario)) return false;
      }
      if (activeBudget !== "all" && priceOf(card) > Number(activeBudget)) return false;
      if (freeOnly?.checked && card.dataset.free !== "true") return false;
      return true;
    }

    function applyFilters() {
      normalizeState();
      planSections.forEach((section) => {
        section.hidden = activeRegion !== "all" && section.dataset.planRegion !== activeRegion;
      });
      filters.forEach((filter) => {
        if (filter.dataset.regionFilter === activeRegion) {
          filter.setAttribute("aria-current", "page");
        } else {
          filter.removeAttribute("aria-current");
        }
      });
      scenarioButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.scenario === activeScenario));
      });
      budgetButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.budget === activeBudget));
      });
      if (sortSelect) sortSelect.value = activeSort;

      const visibleCards = planCards.filter(cardVisible);
      planCards.forEach((card) => {
        card.hidden = !visibleCards.includes(card);
      });

      const sortedCards = [...visibleCards].sort((a, b) => {
        if (activeSort === "price-asc") return priceOf(a) - priceOf(b);
        if (activeSort === "price-desc") return priceOf(b) - priceOf(a);
        if (activeSort === "verified-desc") return (b.dataset.verified ?? "").localeCompare(a.dataset.verified ?? "");
        return scoreOf(b) - scoreOf(a);
      });
      sortedCards.forEach((card) => {
        const grid = card.closest(".plan-grid");
        grid?.append(card);
      });

      planSections.forEach((section) => {
        const hasVisibleCard = !!section.querySelector<HTMLElement>("[data-plan-card]:not([hidden])");
        if (activeRegion === "all") section.hidden = !hasVisibleCard;
      });
      if (emptyState) emptyState.hidden = visibleCards.length > 0;
      if (filterStatus) {
        filterStatus.textContent = `当前显示 ${visibleCards.length} 个套餐`;
      }
    }

    function regionFromUrl() {
      return new URL(window.location.href).searchParams.get("region") ?? "all";
    }

    applyFilters();

    filters.forEach((filter) => {
      filter.addEventListener("click", (event) => {
        event.preventDefault();
        activeRegion = filter.dataset.regionFilter ?? "all";
        const url = new URL(window.location.href);
        if (activeRegion === "all") {
          url.searchParams.delete("region");
        } else {
          url.searchParams.set("region", activeRegion);
        }
        window.history.pushState({}, "", url);
        applyFilters();
      });
    });

    scenarioButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeScenario = button.dataset.scenario ?? "all";
        const url = new URL(window.location.href);
        if (activeScenario === "all") url.searchParams.delete("scenario");
        else url.searchParams.set("scenario", activeScenario);
        window.history.pushState({}, "", url);
        applyFilters();
      });
    });

    budgetButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeBudget = button.dataset.budget ?? "all";
        const url = new URL(window.location.href);
        if (activeBudget === "all") url.searchParams.delete("budget");
        else url.searchParams.set("budget", activeBudget);
        window.history.pushState({}, "", url);
        applyFilters();
      });
    });

    freeOnly?.addEventListener("change", applyFilters);
    sortSelect?.addEventListener("change", () => {
      activeSort = sortSelect.value;
      const url = new URL(window.location.href);
      if (activeSort === "recommended") url.searchParams.delete("sort");
      else url.searchParams.set("sort", activeSort);
      window.history.pushState({}, "", url);
      applyFilters();
    });

    window.addEventListener("popstate", () => {
      const params = new URLSearchParams(window.location.search);
      activeRegion = regionFromUrl();
      activeScenario = params.get("scenario") ?? "all";
      activeBudget = params.get("budget") ?? "all";
      activeSort = params.get("sort") ?? "recommended";
      applyFilters();
    });
  </script>
</BaseLayout>

<style>
  .page-head {
    padding-block: 76px 34px;
  }

  .page-head > p {
    margin: 0 0 13px;
    color: var(--cyan);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 12px;
    font-weight: 800;
  }

  h1 {
    margin: 0;
    font-size: 46px;
  }

  .summary {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 20px;
    color: var(--muted);
    font-size: 13px;
  }

  .plain-note {
    display: flex;
    gap: 10px;
    border-left: 2px solid var(--cyan);
    margin-top: 20px;
    padding: 10px 13px;
    background: rgba(103, 232, 249, 0.055);
  }

  .plain-note strong {
    flex: 0 0 auto;
    font-size: 11px;
  }

  .plain-note span {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.6;
  }

  .plan-section {
    padding-bottom: 90px;
  }

  .region-filter {
    position: sticky;
    top: 70px;
    z-index: 10;
    display: flex;
    gap: 2px;
    border-block: 1px solid var(--line);
    padding-block: 10px;
    background: rgba(5, 7, 13, 0.9);
    backdrop-filter: blur(18px);
  }

  .region-filter a {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    gap: 8px;
    border: 1px solid transparent;
    padding: 0 14px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 750;
  }

  .region-filter a:hover {
    color: var(--text);
  }

  .region-filter a[aria-current="page"] {
    border-color: rgba(103, 232, 249, 0.32);
    background: rgba(103, 232, 249, 0.09);
    color: var(--cyan);
  }

  .region-filter span {
    color: inherit;
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 10px;
  }

  .plan-controls {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 14px;
    border-bottom: 1px solid var(--line);
    padding-block: 18px 20px;
  }

  .plan-controls > div,
  .free-toggle,
  .sort-control {
    min-width: 0;
  }

  .plan-controls span {
    display: block;
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
  }

  .control-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .control-group button {
    min-height: 34px;
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0 11px;
    background: rgba(10, 18, 32, 0.72);
    color: #cbd7e7;
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    font-weight: 760;
  }

  .control-group button:hover {
    color: var(--text);
  }

  .control-group button[aria-pressed="true"] {
    border-color: rgba(103, 232, 249, 0.55);
    background: rgba(103, 232, 249, 0.12);
    color: var(--cyan);
  }

  .free-toggle {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 2px;
    color: #d9e6f5;
    font-size: 12px;
    font-weight: 800;
  }

  .free-toggle input {
    width: 16px;
    height: 16px;
    accent-color: var(--cyan);
  }

  .free-toggle span {
    margin: 0;
    color: inherit;
  }

  .sort-control {
    display: grid;
    gap: 8px;
  }

  .sort-control select {
    min-height: 38px;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0 11px;
    outline: none;
    background: rgba(10, 18, 32, 0.78);
    color: var(--text);
    font: inherit;
    font-size: 12px;
    font-weight: 760;
  }

  .filter-status {
    align-self: end;
    margin: 0;
    color: var(--green);
    font-size: 12px;
    font-weight: 800;
    text-align: right;
  }

  .plan-section {
    padding-top: 30px;
  }

  .region-section + .region-section {
    margin-top: 58px;
  }

  .region-section[hidden] + .region-section {
    margin-top: 0;
  }

  .region-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 20px;
    padding-bottom: 17px;
  }

  .region-heading p {
    margin: 0 0 9px;
    color: var(--cyan);
    font-family: "SFMono-Regular", Consolas, monospace;
    font-size: 11px;
    font-weight: 800;
  }

  .region-heading h2 {
    margin: 0;
    font-size: 26px;
  }

  .region-heading > span {
    color: var(--muted);
    font-size: 12px;
  }

  .plan-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .plan-item {
    display: flex;
    min-width: 0;
  }

  .plan-item > :global(.plan-card) {
    width: 100%;
  }

  .empty-state {
    border: 1px solid var(--line);
    border-radius: 8px;
    margin-bottom: 22px;
    padding: 32px;
    background: rgba(10, 18, 32, 0.64);
    color: var(--muted);
    text-align: center;
  }

  .method-note {
    max-width: 900px;
    margin: 20px 2px 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.7;
  }

  .method-note a {
    color: var(--cyan);
    font-weight: 750;
  }

  @media (max-width: 900px) {
    .plan-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .page-head {
      padding-top: 52px;
    }

    h1 {
      font-size: 36px;
    }

    .plain-note {
      display: grid;
    }

    .plan-controls {
      grid-template-columns: 1fr;
    }

    .filter-status {
      text-align: left;
    }

    .region-filter {
      width: 100%;
      overflow-x: auto;
      padding-inline: 18px;
    }

    .region-filter a {
      flex: 0 0 auto;
    }

    .region-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .plan-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
